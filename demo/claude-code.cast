[0.623, "o", "\u001b[1;35m🛡 pii-mask: personal data found in your prompt. Nothing was sent.\u001b[0m\r\n"]
[0.001, "o", "\u001b[2mMasked copy is in your clipboard, paste it to resend:\u001b[0m\r\n"]
