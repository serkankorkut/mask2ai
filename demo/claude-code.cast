[0.623, "o", "\u001b[32m✓ sent. The model receives only the placeholder.\u001b[0m\r\n"]
[3.505, "o", "\u001b[2J\u001b[H"]
[0.000, "o", "\u001b[2mClaude opens customers.csv to find her details. This is the file on your disk:\u001b[0m\r\n"]
[1.009, "o", "id,first_name,last_name,email,phone,address\r\n1,Ayşe,Yılmaz,ayse.yilmaz@example.com,+90 532 111 22 33,\"Bağdat Cad. No:5 D:2 Kadıköy/İstanbul\"\r\n2,John,Smith,john.smith@example.com,(555) 123-4567,\"123 Main St, Springfield, IL 62704\""]
[0.000, "o", "\r\n"]
[3.145, "o", "\u001b[2mWhat the model receives:\u001b[0m\r\n"]
[0.000, "o", "id,first_name,last_name,email,phone,address\r\n1,\u001b[1;33m__PII_NAME_540193__\u001b[0m,\u001b[1;33m__PII_NAME_cd4ba7__\u001b[0m,\u001b[1;33m__PII_EMAIL_c82211__\u001b[0m,\u001b[1;33m__PII_PHONE_63f285__\u001b[0m,\"\u001b[1;33m__PII_ADDRESS_443ad0__\u001b[0m\"\r\n2,\u001b[1;33m__PII_NAME_8bee59__\u001b[0m,\u001b[1;33m__PII_NAME_a3279c__\u001b[0m,\u001b[1;33m__PII_EMAIL_056666__\u001b[0m,\u001b[1;33m__PII_PHONE_187559__\u001b[0m,\"\u001b[1;33m__PII_ADDRESS_e1980d__\u001b[0m\"\r\n"]
[0.000, "o", "\u001b[1;35m🛡 pii-mask: masked 10 values in Read output\u001b[0m\r\n"]
[5.005, "o", "\u001b[2J\u001b[H"]
[0.000, "o", "\u001b[2mClaude only knows the placeholders, so that is what it writes in its commands:\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;36m● Claude:\u001b[0m sed -i \"s/__PII_EMAIL_c82211__/billing@acme.com/\" customers.csv\r\n"]
[2.138, "o", "\u001b[2mWhat actually runs on your machine:\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32msed -i \"s/ayse.yilmaz@example.com/billing@acme.com/\" customers.csv\u001b[0m\r\n"]
[3.004, "o", "\r\n"]
[0.000, "o", "\u001b[2mNames, emails, phones, cards, IBANs, IDs and addresses stay on your machine.\u001b[0m\r\n"]
[1.009, "o", "\u001b[2mThe model only ever sees placeholders. Verify it yourself: node demo/prove.js\u001b[0m\r\n"]
[5.017, "x", "0"]
