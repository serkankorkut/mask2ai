[0.636, "o", "\u001b[32m✓ sent. The model receives only the placeholder.\u001b[0m\r\n"]
[3.505, "o", "\u001b[2J\u001b[H"]
[0.000, "o", "\u001b[2mClaude opens customers.csv to find her details. This is the file on your disk:\u001b[0m\r\n"]
[1.017, "o", "id,first_name,last_name,email,phone,address\r\n1,Ayşe,Yılmaz,ayse.yilmaz@example.com,+90 532 111 22 33,\"Bağdat Cad. No:5 D:2 Kadıköy/İstanbul\"\r\n2,John,Smith,john.smith@example.com,(555) 123-4567,\"123 Main St, Springfield, IL 62704\""]
[0.000, "o", "\r\n"]
[3.147, "o", "\u001b[2mWhat the model receives:\u001b[0m\r\n"]
[0.001, "o", "id,first_name,last_name,email,phone,address\r\n1,\u001b[1;33m__PII_NAME_fddca8__\u001b[0m,\u001b[1;33m__PII_NAME_b1e726__\u001b[0m,\u001b[1;33m__PII_EMAIL_b473d7__\u001b[0m,\u001b[1;33m__PII_PHONE_6edafb__\u001b[0m,\"\u001b[1;33m__PII_ADDRESS_23d815__\u001b[0m\"\r\n2,\u001b[1;33m__PII_NAME_5753a4__\u001b[0m,\u001b[1;33m__PII_NAME_96bcf8__\u001b[0m,\u001b[1;33m__PII_EMAIL_fda418__\u001b[0m,\u001b[1;33m__PII_PHONE_820be6__\u001b[0m,\"\u001b[1;33m__PII_ADDRESS_5f5430__\u001b[0m\"\r\n"]
[0.000, "o", "\u001b[1;35m🛡 pii-mask: masked 10 values in Read output\u001b[0m\r\n"]
[5.007, "o", "\u001b[2J\u001b[H"]
[0.000, "o", "\u001b[2mClaude only knows the placeholders, so that is what it writes in its commands:\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;36m● Claude:\u001b[0m sed -i \"s/__PII_EMAIL_b473d7__/billing@acme.com/\" customers.csv\r\n"]
[2.140, "o", "\u001b[2mWhat actually runs on your machine:\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32msed -i \"s/ayse.yilmaz@example.com/billing@acme.com/\" customers.csv\u001b[0m\r\n"]
[3.005, "o", "\r\n"]
[0.000, "o", "\u001b[2mNames, emails, phones, cards, IBANs, IDs and addresses stay on your machine.\u001b[0m\r\n"]
[1.012, "o", "\u001b[2mThe model only ever sees placeholders. Verify it yourself: node demo/prove.js\u001b[0m\r\n"]
[5.020, "x", "0"]
